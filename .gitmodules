[submodule "linux/vscode/.config/Code/User/prompts"]
	path = linux/vscode/.config/Code/User/prompts
	url = https://github.com/jcchikikomori/impromptu
[submodule "linux/opencode"]
	path = linux/opencode
	url = https://github.com/jcchikikomori/dotfiles-opencode.git
[submodule "linux/claude"]
	path = linux/claude
	url = https://github.com/jcchikikomori/dotfiles-claude.git
[submodule "linux/mpv/.config/mpv"]
	path = linux/mpv/.config/mpv
	url = https://github.com/jcchikikomori/mpv-config.git
[submodule "linux/neovim/.config/nvim"]
	path = linux/neovim/.config/nvim
	url = https://github.com/jcchikikomori/LazyVim.git
