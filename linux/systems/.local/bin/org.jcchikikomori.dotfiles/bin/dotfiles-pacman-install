#!/bin/sh

# Shared pacman install helper for Arch-based systems.
# Source this file to get is_forced_package(), pacman_install(), and
# confirm_aur_install() functions.

# Space-separated package list to force install on file conflicts.
# Example: PACMAN_FORCE_CONFLICT_PACKAGES="python3 openssh" dotfiles-arch setup
PACMAN_FORCE_CONFLICT_PACKAGES="${PACMAN_FORCE_CONFLICT_PACKAGES:-}"
PACMAN_OVERWRITE_GLOB="${PACMAN_OVERWRITE_GLOB:-*}"

df_pacman_info() {
  if command -v df_info >/dev/null 2>&1; then
    df_info "$*"
  else
    echo "$*"
  fi
}

df_pacman_run() {
  if command -v df_run >/dev/null 2>&1; then
    df_run "$@"
  else
    "$@"
  fi
}

df_pacman_run_interactive() {
  if command -v df_run_interactive >/dev/null 2>&1; then
    df_run_interactive "$@"
  else
    "$@"
  fi
}

is_forced_package() {
  package_name="$1"
  for forced_pkg in $PACMAN_FORCE_CONFLICT_PACKAGES; do
    if [ "$forced_pkg" = "$package_name" ]; then
      return 0
    fi
  done
  return 1
}

pacman_install() {
  pacman_args="$1"
  shift

  regular_packages=""
  forced_packages=""

  for package_name in "$@"; do
    if is_forced_package "$package_name"; then
      forced_packages="$forced_packages $package_name"
    else
      regular_packages="$regular_packages $package_name"
    fi
  done

  if [ -n "$regular_packages" ]; then
    # shellcheck disable=SC2086
    df_pacman_run sudo pacman $pacman_args $regular_packages || return 1
  fi

  if [ -n "$forced_packages" ]; then
    df_pacman_info "Installing forced packages with overwrite glob: $PACMAN_OVERWRITE_GLOB"
    # shellcheck disable=SC2086
    df_pacman_run sudo pacman $pacman_args --overwrite "$PACMAN_OVERWRITE_GLOB" $forced_packages || return 1
  fi
}

# Prompt to confirm installing an AUR package. Returns 0 to proceed, 1 to skip.
# Skips the prompt entirely in CI or when SKIP_INSTALL_PROGLANG is set.
confirm_aur_install() {
  package_name="$1"

  CI_MODE="${CI:-false}"
  if [ "$CI_MODE" = "true" ] || [ -n "${SKIP_INSTALL_PROGLANG:-}" ]; then
    return 0
  fi

  df_pacman_run_interactive printf "\n"
  df_pacman_run_interactive printf "WARNING: Installing AUR package: %s\n" "$package_name"
  df_pacman_run_interactive printf "Source: AUR (Arch User Repository)\n"
  df_pacman_run_interactive printf "Supply chain risk: AUR packages are maintained by volunteers and may become\n"
  df_pacman_run_interactive printf "orphaned, compromised, or contain malicious code. See:\n"
  df_pacman_run_interactive printf "  https://archlinux.org/news/active-aur-malicious-packages-incident/\n"
  df_pacman_run_interactive printf "\n"
  df_pacman_run_interactive printf "Continue with installation? [Y/n] "
  read -r confirm || confirm=n
  case "$confirm" in
    [nN]|[nN][oO])
      df_pacman_info "Skipping $package_name (user declined)"
      return 1
      ;;
  esac
}
