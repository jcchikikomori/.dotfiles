#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -r "${DOTFILES_BIN:-$SCRIPT_DIR}/dotfiles-lib-output" ]; then
  echo "[dotfiles:cleanup-bin] Error: dotfiles-lib-output not found" >&2
  exit 1
fi

# shellcheck source=/dev/null
. "${DOTFILES_BIN:-$SCRIPT_DIR}/dotfiles-lib-output"

CLEANUP_BIN_VERBOSE=0
for arg in "$@"; do
  case "$arg" in
    --verbose|-v)
      CLEANUP_BIN_VERBOSE=1
      ;;
  esac
done

DF_PREFIX="cleanup-bin"
if [ "$CLEANUP_BIN_VERBOSE" -eq 1 ]; then
  df_output_init --verbose
else
  df_output_init
fi

df_info "Cleaning up scripts in $HOME/.local/bin/org.jcchikikomori.dotfiles/bin..."

# Check if the file is a symlink
if [ -L "$HOME/.local/bin/org.jcchikikomori.dotfiles/bin" ]; then
  df_info "Deleting symlink $HOME/.local/bin/org.jcchikikomori.dotfiles/bin..."
  rm -f $HOME/.local/bin/org.jcchikikomori.dotfiles/bin
fi

df_info "Cleaning up scripts in $HOME/.local/bin/org.jcchikikomori.agentic.claude/bin..."

# Check if the file is a symlink
if [ -L "$HOME/.local/bin/org.jcchikikomori.agentic.claude/bin" ]; then
  df_info "Deleting symlink $HOME/.local/bin/org.jcchikikomori.agentic.claude/bin..."
  rm -f $HOME/.local/bin/org.jcchikikomori.agentic.claude/bin
fi

df_info "Cleaning up scripts in $HOME/.local/bin/org.jcchikikomori.agentic.opencode/bin..."

# Check if the file is a symlink
if [ -L "$HOME/.local/bin/org.jcchikikomori.agentic.opencode/bin" ]; then
  df_info "Deleting symlink $HOME/.local/bin/org.jcchikikomori.agentic.opencode/bin..."
  rm -f $HOME/.local/bin/org.jcchikikomori.agentic.opencode/bin
fi

df_info "Cleaning up scripts in $HOME/.local/bin/org.jcchikikomori.devtools/bin..."

# Check if the file is a symlink
if [ -L "$HOME/.local/bin/org.jcchikikomori.devtools/bin" ]; then
  df_info "Deleting symlink $HOME/.local/bin/org.jcchikikomori.devtools/bin..."
  rm -f $HOME/.local/bin/org.jcchikikomori.devtools/bin
fi

df_info "Cleaning up scripts in $HOME/.local/bin/org.jcchikikomori.emudecktools/bin..."

# Check if the file is a symlink
if [ -L "$HOME/.local/bin/org.jcchikikomori.emudecktools/bin" ]; then
  df_info "Deleting symlink $HOME/.local/bin/org.jcchikikomori.emudecktools/bin..."
  rm -f $HOME/.local/bin/org.jcchikikomori.emudecktools/bin
fi

df_ok "Scripts cleanup completed."
