#!/bin/sh

set -eu

SERVICE_NAME="copyparty.service"
SERVICE_DIR="$HOME/.config/systemd/user"
SERVICE_FILE="$SERVICE_DIR/$SERVICE_NAME"
REPO_SERVICE_TEMPLATE="$HOME/.dotfiles/linux/systems/.config/systemd/user/$SERVICE_NAME"
CONFIG_DIR="$HOME/.config/copyparty"
ENV_FILE="$CONFIG_DIR/copyparty.env"
RUNTIME_DIR="$HOME/.local/state/copyparty"
PID_FILE="$RUNTIME_DIR/copyparty.pid"
LOG_FILE="$RUNTIME_DIR/copyparty.log"
PROFILE_LOCAL="$HOME/.profile.local"
AUTOSTART_BEGIN_MARKER="# BEGIN dotfiles-copyparty autostart (managed by dotfiles-copyparty)"
AUTOSTART_END_MARKER="# END dotfiles-copyparty autostart (managed by dotfiles-copyparty)"
COPIPARTY_BIN="$HOME/.local/bin/copyparty"

# Resolved per invocation by resolve_service_mode: "systemd" or "process".
SERVICE_MODE=""

log_info() {
  echo "[dotfiles-copyparty] $1"
}

log_error() {
  echo "[dotfiles-copyparty] ERROR: $1" >&2
}

is_wsl() {
  [ -f /proc/version ] && grep -qi microsoft /proc/version
}

log_wsl_hint() {
  if is_wsl; then
    log_info "systemd is not available in this WSL session."
    log_info "Tip: run 'dotfiles-wsl' and restart WSL (wsl.exe --shutdown) to enable systemd for proper service management."
    log_info "Note: WSL may terminate background processes when all terminals are closed."
  fi
}

resolve_service_mode() {
  if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    SERVICE_MODE="systemd"
  else
    SERVICE_MODE="process"
  fi
}

check_required_tools() {
  if [ "$SERVICE_MODE" = "systemd" ] && ! command -v systemctl >/dev/null 2>&1; then
    log_error "systemctl is required but not found"
    return 1
  fi

  if ! command -v python3 >/dev/null 2>&1 && ! command -v uv >/dev/null 2>&1; then
    log_error "python3 or uv is required but not found"
    return 1
  fi
}

ensure_pipx() {
  if command -v pipx >/dev/null 2>&1; then
    return 0
  fi

  # Ensure ~/.local/bin is in PATH so pipx binary is discoverable
  export PATH="$HOME/.local/bin:$PATH"

  log_info "pipx not found. Installing pipx for current user..."

  # Helper: install via pip, dropping --user if inside a venv
  _pip_install_pipx() {
    if [ -n "$VIRTUAL_ENV" ]; then
      log_info "  (inside venv, using pip without --user)"
      python3 -m pip install pipx
    else
      python3 -m pip install --user --upgrade pipx
    fi
  }

  # Strategy 1: python3 -m pip
  if command -v python3 >/dev/null 2>&1 && python3 -m pip --version >/dev/null 2>&1; then
    _pip_install_pipx
  # Strategy 2: uv tool install
  elif command -v uv >/dev/null 2>&1; then
    log_info "pip not available, installing pipx via uv..."
    uv tool install pipx
  else
    log_error "Neither pip nor uv found. Install Python first via dotfiles-python."
    return 1
  fi

  # Locate pipx binary (may be in ~/.local/bin or inside an active venv)
  PIPX_BIN=""
  if [ -x "$HOME/.local/bin/pipx" ]; then
    PIPX_BIN="$HOME/.local/bin/pipx"
  elif [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/pipx" ]; then
    PIPX_BIN="$VIRTUAL_ENV/bin/pipx"
  elif command -v pipx >/dev/null 2>&1; then
    PIPX_BIN="$(command -v pipx)"
  fi

  if [ -z "$PIPX_BIN" ]; then
    log_error "pipx installation failed — binary not found"
    return 1
  fi

  "$PIPX_BIN" ensurepath >/dev/null 2>&1 || true
}

install_copyparty() {
  PIPX_BIN=$(command -v pipx || true)
  if [ -z "$PIPX_BIN" ] && [ -x "$HOME/.local/bin/pipx" ]; then
    PIPX_BIN="$HOME/.local/bin/pipx"
  fi
  if [ -z "$PIPX_BIN" ] && [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/pipx" ]; then
    PIPX_BIN="$VIRTUAL_ENV/bin/pipx"
  fi

  if [ -z "$PIPX_BIN" ]; then
    log_error "Unable to locate pipx"
    return 1
  fi

  log_info "Installing copyparty using pipx..."
  "$PIPX_BIN" install --force copyparty
}

ensure_default_share_dirs() {
  mkdir -p "$HOME/Downloads" "$HOME/Pictures" "$HOME/Videos"
}

ensure_default_env() {
  mkdir -p "$CONFIG_DIR"
  if [ ! -f "$ENV_FILE" ]; then
    write_env_file "3923" "0" "" "0" "" ""
  fi
}

strip_wrapping_quotes() {
  val="$1"
  case "$val" in
    \"*\")
      val=${val#\"}
      val=${val%\"}
      ;;
  esac
  printf '%s' "$val"
}

get_env_value() {
  key="$1"
  default_value="$2"

  if [ ! -f "$ENV_FILE" ]; then
    printf '%s' "$default_value"
    return
  fi

  raw_value=$(grep "^${key}=" "$ENV_FILE" | tail -n 1 | cut -d '=' -f 2- || true)
  if [ -z "$raw_value" ]; then
    printf '%s' "$default_value"
    return
  fi

  strip_wrapping_quotes "$raw_value"
}

escape_env_value() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_env_file() {
  env_port="$1"
  env_debug="$2"
  env_extra_args="$3"
  env_auth_enabled="$4"
  env_username="$5"
  env_password="$6"
  escaped_extra_args=$(escape_env_value "$env_extra_args")
  escaped_username=$(escape_env_value "$env_username")
  escaped_password=$(escape_env_value "$env_password")

  mkdir -p "$CONFIG_DIR"
  cat >"$ENV_FILE" <<EOF
COPYPARTY_PORT=3923
COPYPARTY_DEBUG=0
COPYPARTY_EXTRA_ARGS=""
COPYPARTY_AUTH_ENABLED=0
COPYPARTY_USERNAME=""
COPYPARTY_PASSWORD=""
EOF

  sed -i "s/^COPYPARTY_PORT=.*/COPYPARTY_PORT=${env_port}/" "$ENV_FILE"
  sed -i "s/^COPYPARTY_DEBUG=.*/COPYPARTY_DEBUG=${env_debug}/" "$ENV_FILE"
  sed -i "s/^COPYPARTY_EXTRA_ARGS=.*/COPYPARTY_EXTRA_ARGS=\"${escaped_extra_args}\"/" "$ENV_FILE"
  sed -i "s/^COPYPARTY_AUTH_ENABLED=.*/COPYPARTY_AUTH_ENABLED=${env_auth_enabled}/" "$ENV_FILE"
  sed -i "s/^COPYPARTY_USERNAME=.*/COPYPARTY_USERNAME=\"${escaped_username}\"/" "$ENV_FILE"
  sed -i "s/^COPYPARTY_PASSWORD=.*/COPYPARTY_PASSWORD=\"${escaped_password}\"/" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

process_running() {
  RUNNING_PID=""
  if [ ! -f "$PID_FILE" ]; then
    return 1
  fi

  RUNNING_PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$RUNNING_PID" ] && kill -0 "$RUNNING_PID" 2>/dev/null; then
    return 0
  fi

  # Stale PID file: process no longer alive.
  rm -f "$PID_FILE"
  return 1
}

start_process() {
  ensure_default_env

  if process_running; then
    log_info "Copyparty already running (PID $RUNNING_PID)"
    return 0
  fi

  mkdir -p "$RUNTIME_DIR"

  # Source the environment file generated by write_env_file (chmod 600,
  # plain KEY="value" assignments written by this script only).
  . "$ENV_FILE"

  if [ "${COPYPARTY_DEBUG:-0}" = "1" ]; then
    set -x
  fi

  # Mirrors the ExecStart command in copyparty.service — keep in sync.
  if [ "${COPYPARTY_AUTH_ENABLED:-0}" = "1" ]; then
    nohup "$COPIPARTY_BIN" -p "${COPYPARTY_PORT:-3923}" ${COPYPARTY_EXTRA_ARGS:-} \
      -a "${COPYPARTY_USERNAME}:${COPYPARTY_PASSWORD}" \
      -v "$HOME:/:rwmd,${COPYPARTY_USERNAME}" >>"$LOG_FILE" 2>&1 &
  else
    nohup "$COPIPARTY_BIN" -p "${COPYPARTY_PORT:-3923}" ${COPYPARTY_EXTRA_ARGS:-} \
      -v "$HOME/Downloads:/downloads:r" \
      -v "$HOME/Pictures:/pictures:r" \
      -v "$HOME/Videos:/videos:r" >>"$LOG_FILE" 2>&1 &
  fi
  launched_pid=$!
  set +x

  printf '%s\n' "$launched_pid" >"$PID_FILE"
  log_info "Copyparty started in background mode (PID $launched_pid, log: $LOG_FILE)"
}

kill_process() {
  # Stop the background process without touching autostart configuration.
  if ! process_running; then
    return 0
  fi

  kill "$RUNNING_PID" 2>/dev/null || true

  wait_counter=0
  while [ "$wait_counter" -lt 5 ] && kill -0 "$RUNNING_PID" 2>/dev/null; do
    wait_counter=$((wait_counter + 1))
    sleep 1
  done

  if kill -0 "$RUNNING_PID" 2>/dev/null; then
    log_info "Process $RUNNING_PID did not exit after TERM; sending KILL"
    kill -9 "$RUNNING_PID" 2>/dev/null || true
    wait_counter=0
    while [ "$wait_counter" -lt 5 ] && kill -0 "$RUNNING_PID" 2>/dev/null; do
      wait_counter=$((wait_counter + 1))
      sleep 1
    done
  fi

  rm -f "$PID_FILE"
  log_info "Stopped copyparty process (PID $RUNNING_PID)"
}

add_autostart_block() {
  if grep -q "^${AUTOSTART_BEGIN_MARKER}$" "$PROFILE_LOCAL" 2>/dev/null; then
    log_info "Autostart already configured in $PROFILE_LOCAL"
    return 0
  fi

  cat >>"$PROFILE_LOCAL" <<EOF
$AUTOSTART_BEGIN_MARKER
if command -v dotfiles-copyparty >/dev/null 2>&1; then
  dotfiles-copyparty start >/dev/null 2>&1 &
fi
$AUTOSTART_END_MARKER
EOF
  log_info "Added autostart block to $PROFILE_LOCAL (sourced by ~/.profile)"
}

remove_autostart_block() {
  if [ ! -f "$PROFILE_LOCAL" ]; then
    return 0
  fi

  if ! grep -q "^${AUTOSTART_BEGIN_MARKER}$" "$PROFILE_LOCAL" 2>/dev/null; then
    return 0
  fi

  sed -i "/^${AUTOSTART_BEGIN_MARKER}\$/,/^${AUTOSTART_END_MARKER}\$/d" "$PROFILE_LOCAL"
  log_info "Removed autostart block from $PROFILE_LOCAL"
}

stop_process() {
  remove_autostart_block
  kill_process
}

status_process() {
  if process_running; then
    log_info "Copyparty is running (PID $RUNNING_PID)"
    return 0
  fi
  log_info "Copyparty is not running (background mode)"
  return 1
}

logs_process() {
  if [ -f "$LOG_FILE" ]; then
    tail -n 100 "$LOG_FILE"
  else
    log_info "No logs yet at $LOG_FILE"
  fi
}

restart_if_active() {
  if [ "$SERVICE_MODE" = "systemd" ]; then
    systemctl --user daemon-reload
    if systemctl --user is-active --quiet "$SERVICE_NAME"; then
      systemctl --user restart "$SERVICE_NAME"
      return 0
    fi
    return 1
  fi

  if process_running; then
    kill_process
    start_process
    return 0
  fi
  return 1
}

read_secret() {
  prompt="$1"
  printf '%s' "$prompt" >&2
  stty -echo
  IFS= read -r secret
  stty echo
  printf '\n' >&2
  printf '%s' "$secret"
}

setup_auth_wizard() {
  ensure_default_env

  default_username=$(id -un 2>/dev/null || echo "user")
  current_username=$(get_env_value "COPYPARTY_USERNAME" "$default_username")
  if [ -n "$current_username" ]; then
    printf 'Copyparty username [%s]: ' "$current_username" >&2
  else
    printf 'Copyparty username: ' >&2
  fi
  IFS= read -r input_username
  if [ -n "$input_username" ]; then
    username="$input_username"
  else
    username="$current_username"
  fi

  if [ -z "$username" ]; then
    log_error "Username cannot be empty"
    return 1
  fi

  password=$(read_secret "Copyparty password: ")
  if [ -z "$password" ]; then
    log_error "Password cannot be empty"
    return 1
  fi

  password_confirm=$(read_secret "Confirm password: ")
  if [ "$password" != "$password_confirm" ]; then
    log_error "Password confirmation does not match"
    return 1
  fi

  port=$(get_env_value "COPYPARTY_PORT" "3923")
  debug=$(get_env_value "COPYPARTY_DEBUG" "0")
  extra_args=$(get_env_value "COPYPARTY_EXTRA_ARGS" "")
  write_env_file "$port" "$debug" "$extra_args" "1" "$username" "$password"

  if restart_if_active; then
    log_info "Authentication enabled for user '$username' and $SERVICE_NAME restarted"
  else
    log_info "Authentication enabled for user '$username'"
    log_info "Run 'dotfiles-copyparty start' to apply"
  fi
}

disable_auth() {
  ensure_default_env
  port=$(get_env_value "COPYPARTY_PORT" "3923")
  debug=$(get_env_value "COPYPARTY_DEBUG" "0")
  extra_args=$(get_env_value "COPYPARTY_EXTRA_ARGS" "")
  write_env_file "$port" "$debug" "$extra_args" "0" "" ""

  if restart_if_active; then
    log_info "Authentication disabled and $SERVICE_NAME restarted"
  else
    log_info "Authentication disabled"
    log_info "Run 'dotfiles-copyparty start' to apply"
  fi
}

install_user_service() {
  mkdir -p "$SERVICE_DIR"

  if [ ! -f "$REPO_SERVICE_TEMPLATE" ]; then
    log_error "Service template not found at $REPO_SERVICE_TEMPLATE"
    return 1
  fi

  cp "$REPO_SERVICE_TEMPLATE" "$SERVICE_FILE"
  if [ "$SERVICE_MODE" = "systemd" ]; then
    systemctl --user daemon-reload
  else
    log_info "systemd user session not available; unit file installed for future use (daemon-reload skipped)"
  fi
}

install() {
  check_required_tools
  ensure_pipx
  install_copyparty
  ensure_default_share_dirs
  ensure_default_env
  install_user_service
  if [ "$SERVICE_MODE" = "process" ]; then
    log_wsl_hint
  fi

  log_info "Copyparty installed."
  log_info "Default shared paths: $HOME/Downloads, $HOME/Pictures, $HOME/Videos"
  log_info "Default port: 3923"
  log_info "Set custom port: dotfiles-copyparty set-port <port>"
  log_info "Enable debug mode: dotfiles-copyparty set-debug on"
  log_info "Set extra copyparty args: dotfiles-copyparty set-args '<args>'"
  log_info "Configure authentication: dotfiles-copyparty setup-auth"
  log_info "Run 'dotfiles-copyparty start' to start once."
  log_info "Run 'dotfiles-copyparty startup' to enable on login."

  if [ -t 0 ]; then
    printf 'Enable copyparty authentication for full $HOME management? (y/n): ' >&2
    IFS= read -r enable_auth
    if [ "$enable_auth" = "y" ] || [ "$enable_auth" = "Y" ]; then
      setup_auth_wizard
    else
      log_info "Authentication wizard skipped"
    fi
  else
    log_info "No interactive terminal detected; skipping auth wizard"
    log_info "Run 'dotfiles-copyparty setup-auth' later"
  fi
}

set_port() {
  if [ $# -lt 1 ]; then
    log_error "Missing port. Usage: dotfiles-copyparty set-port <port>"
    return 1
  fi

  port="$1"
  if ! echo "$port" | grep -Eq '^[0-9]+$'; then
    log_error "Port must be a number"
    return 1
  fi

  if [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
    log_error "Port must be between 1024 and 65535"
    return 1
  fi

  ensure_default_env
  debug=$(get_env_value "COPYPARTY_DEBUG" "0")
  extra_args=$(get_env_value "COPYPARTY_EXTRA_ARGS" "")
  auth_enabled=$(get_env_value "COPYPARTY_AUTH_ENABLED" "0")
  username=$(get_env_value "COPYPARTY_USERNAME" "")
  password=$(get_env_value "COPYPARTY_PASSWORD" "")
  write_env_file "$port" "$debug" "$extra_args" "$auth_enabled" "$username" "$password"

  if restart_if_active; then
    log_info "Updated port to $port and restarted $SERVICE_NAME"
  else
    log_info "Updated port to $port"
    log_info "Run 'dotfiles-copyparty start' to apply"
  fi
}

set_debug() {
  if [ $# -lt 1 ]; then
    log_error "Missing value. Usage: dotfiles-copyparty set-debug <on|off>"
    return 1
  fi

  case "$1" in
    on)
      debug="1"
      ;;
    off)
      debug="0"
      ;;
    *)
      log_error "Invalid value '$1'. Use on or off"
      return 1
      ;;
  esac

  ensure_default_env
  port=$(get_env_value "COPYPARTY_PORT" "3923")
  extra_args=$(get_env_value "COPYPARTY_EXTRA_ARGS" "")
  auth_enabled=$(get_env_value "COPYPARTY_AUTH_ENABLED" "0")
  username=$(get_env_value "COPYPARTY_USERNAME" "")
  password=$(get_env_value "COPYPARTY_PASSWORD" "")
  write_env_file "$port" "$debug" "$extra_args" "$auth_enabled" "$username" "$password"

  if restart_if_active; then
    log_info "Debug mode updated to $1 and restarted $SERVICE_NAME"
  else
    log_info "Debug mode updated to $1"
    log_info "Run 'dotfiles-copyparty start' to apply"
  fi
}

set_args() {
  if [ $# -lt 1 ]; then
    log_error "Missing args. Usage: dotfiles-copyparty set-args '<args>'"
    return 1
  fi

  extra_args="$*"
  ensure_default_env
  port=$(get_env_value "COPYPARTY_PORT" "3923")
  debug=$(get_env_value "COPYPARTY_DEBUG" "0")
  auth_enabled=$(get_env_value "COPYPARTY_AUTH_ENABLED" "0")
  username=$(get_env_value "COPYPARTY_USERNAME" "")
  password=$(get_env_value "COPYPARTY_PASSWORD" "")
  write_env_file "$port" "$debug" "$extra_args" "$auth_enabled" "$username" "$password"

  if restart_if_active; then
    log_info "Updated extra args and restarted $SERVICE_NAME"
  else
    log_info "Updated extra args"
    log_info "Run 'dotfiles-copyparty start' to apply"
  fi
}

start() {
  if [ "$SERVICE_MODE" = "systemd" ]; then
    systemctl --user start "$SERVICE_NAME"
    log_info "Service started: $SERVICE_NAME"
    return 0
  fi

  log_info "systemd user session not available; using background-process mode"
  start_process
  log_wsl_hint
}

startup() {
  if [ "$SERVICE_MODE" = "systemd" ]; then
    systemctl --user enable --now "$SERVICE_NAME"
    log_info "Service enabled and started: $SERVICE_NAME"
    return 0
  fi

  add_autostart_block
  start_process
  log_wsl_hint
}

stop() {
  if [ "$SERVICE_MODE" = "systemd" ]; then
    systemctl --user disable --now "$SERVICE_NAME"
    log_info "Service disabled and stopped: $SERVICE_NAME"
    return 0
  fi

  stop_process
  log_info "Copyparty stopped and autostart removed"
}

status() {
  if [ "$SERVICE_MODE" = "systemd" ]; then
    systemctl --user status "$SERVICE_NAME"
  else
    status_process
  fi
}

logs() {
  if [ "$SERVICE_MODE" = "systemd" ]; then
    journalctl --user -u "$SERVICE_NAME" -n 100 --no-pager
  else
    logs_process
  fi
}

usage() {
  echo "Usage: $0 {install|start|startup|stop|status|logs|set-port|set-debug|set-args|setup-auth|disable-auth}"
  echo "Runs as a systemd user service when a systemd user session is available;"
  echo "otherwise manages a background process (state in ~/.local/state/copyparty/)."
  echo "  install: Install copyparty via pipx and install user service"
  echo "  start: Start copyparty service"
  echo "  startup: Enable and start copyparty on user login"
  echo "  stop: Disable and stop copyparty service"
  echo "  status: Show service status"
  echo "  logs: Show recent service logs"
  echo "  set-port: Set custom service port (1024-65535)"
  echo "  set-debug: Toggle debug shell tracing (on|off)"
  echo "  set-args: Set extra copyparty command-line args"
  echo "  setup-auth: Interactive wizard for username/password auth"
  echo "  disable-auth: Disable auth and clear stored credentials"
}

main() {
  if [ $# -eq 0 ]; then
    usage
    exit 1
  fi

  resolve_service_mode

  case "$1" in
    install)
      install
      ;;
    start)
      start
      ;;
    startup)
      startup
      ;;
    stop)
      stop
      ;;
    status)
      status
      ;;
    logs)
      logs
      ;;
    set-port)
      shift
      set_port "$@"
      ;;
    set-debug)
      shift
      set_debug "$@"
      ;;
    set-args)
      shift
      set_args "$@"
      ;;
    setup-auth)
      shift
      setup_auth_wizard "$@"
      ;;
    disable-auth)
      shift
      disable_auth "$@"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
