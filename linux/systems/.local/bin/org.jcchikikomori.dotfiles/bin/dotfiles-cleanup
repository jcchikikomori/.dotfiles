#!/bin/sh

# Issues occurring with the script: vim, zsh & systems (.profile file)

DOTSTOW_BIN=$(command -v dotstow 2>/dev/null)
if [ -z "$DOTSTOW_BIN" ] && [ -x "$HOME/.local/bin/org.jcchikikomori.dotfiles/bin/dotstow" ]; then
  DOTSTOW_BIN="$HOME/.local/bin/org.jcchikikomori.dotfiles/bin/dotstow"
fi
if [ -z "$DOTSTOW_BIN" ] && [ -x "/usr/local/bin/dotstow" ]; then
  DOTSTOW_BIN="/usr/local/bin/dotstow"
fi
if [ -z "$DOTSTOW_BIN" ] && [ -x "/opt/homebrew/bin/dotstow" ]; then
  DOTSTOW_BIN="/opt/homebrew/bin/dotstow"
fi

# Check if dotstow is available and executable
if [ -z "$DOTSTOW_BIN" ]; then
  echo "Error: dotstow command not found in PATH or known install locations. Aborting." >&2
  exit 1
fi

echo 'Unstowing...'
if [ "$(uname -s 2>/dev/null)" = "Darwin" ]; then
  "$DOTSTOW_BIN" unstow git antigen tmux tmuxp vscode systems opencode claude
else
  "$DOTSTOW_BIN" unstow git antigen tmux tmuxp vscode dxvk bash opencode claude
  "$DOTSTOW_BIN" unstow flatpak systems wireplumber
fi

# Backup helper: copies file/dir to $HOME/.backups if it exists and is not a symlink
backup_item() {
  local src="$1"
  local label="${2:-$(basename "$src")}"
  if [ -e "$src" ] && [ ! -L "$src" ]; then
    mkdir -p "$HOME/.backups"
    cp -a "$src" "$HOME/.backups/"
    echo "  backed up $label"
  fi
}

# Backup helper with path exclusions for AI tool dirs.
# ~/.claude/plugins/marketplaces/*/ are cloned git repos whose
# .git/objects/pack/ packfiles frequently have restrictive permissions
# (mode 000 / set by the host tooling), which makes `cp -a` fail with
# "Permission denied" and clutters the stow log. Those packfiles are
# regenerable via `git fetch` in each marketplace, not user data — skipping
# them is safe. Uses tar for portable --exclude support across GNU tar
# (Linux/Termux) and BSD tar (macOS). --strip-components=1 keeps the
# resulting tree at $HOME/.backups/$label/ rather than nesting under it.
backup_item_excluding() {
  local src="$1"
  local label="${2:-$(basename "$src")}"
  shift 2
  if [ -e "$src" ] && [ ! -L "$src" ]; then
    mkdir -p "$HOME/.backups"
    if [ -d "$src" ]; then
      mkdir -p "$HOME/.backups/$label"
      # Build --exclude flags from the remaining positional args
      exclude_args=""
      for pattern in "$@"; do
        exclude_args="$exclude_args --exclude=$pattern"
      done
      # shellcheck disable=SC2086
      tar $exclude_args -cf - -C "$(dirname "$src")" "$(basename "$src")" 2>/dev/null \
        | tar --strip-components=1 -xf - -C "$HOME/.backups/$label"
    else
      cp -a "$src" "$HOME/.backups/"
    fi
    echo "  backed up $label"
  fi
}

# Remove a target file at $HOME/<path>, but never let the rm reach through a
# directory symlink and delete a tracked source file inside the dotfiles
# repo. When stow bundles a package subdirectory as a single directory
# symlink (e.g. ~/.pyenv -> ~/.dotfiles/linux/python/.pyenv), a plain
# `rm -f $HOME/.pyenv/version` follows through the symlink and deletes the
# source. If $target's canonical path resolves inside $pkg_dir (the dotfiles
# repo's package subdirectory), the target is a tracked source — never
# `rm` it directly. Walk up the path from $target and unlink the first
# directory symlink in the chain so `stow` can recreate the tree on
# restow. Otherwise fall back to a normal `rm -f` to clear stale real
# files (e.g. pyenv's own ~/.pyenv/version written before stow ran).
#
# GitHub: #241
safe_rm_stow_target() {
  local target="$1"
  local pkg_dir="$2"

  local target_dir
  target_dir=$(dirname -- "$target")

  local target_canonical pkg_canonical
  if target_canonical=$(CDPATH= cd -P -- "$target_dir" 2>/dev/null && pwd); then
    target_canonical="$target_canonical/$(basename -- "$target")"
  else
    target_canonical=
  fi
  pkg_canonical=$(CDPATH= cd -P -- "$pkg_dir" 2>/dev/null && pwd) || pkg_canonical=

  # Only intervene if the file lives under the package source tree.
  # Use `case` for the prefix check — `[ ... = "${dir}/"* ]` is unreliable
  # across POSIX shells (dash glob-expands the trailing `*` and reports
  # "too many arguments" once the package dir contains real files).
  if [ -n "$target_canonical" ] && [ -n "$pkg_canonical" ]; then
    case "$target_canonical" in
    "${pkg_canonical}/"*)
      local check_dir="$target_dir"
      while [ -n "$check_dir" ] && [ "$check_dir" != "/" ]; do
        if [ -L "$check_dir" ]; then
          rm -f "$check_dir"
          return 0
        fi
        check_dir=$(dirname -- "$check_dir")
      done
      ;;
    esac
  fi

  rm -f "$target"
}

echo 'Backing up...'
mkdir -p "$HOME/.backups"
mkdir -p "$HOME/.backups/opencode"
mkdir -p "$HOME/.binbackups"

backup_item "$HOME/.ssh"
backup_item "$HOME/.zsh"
backup_item "$HOME/.zshrc"
backup_item "$HOME/.zprofile"
backup_item "$HOME/.profile"
backup_item "$HOME/.zshrc.pre-oh-my-zsh"
backup_item "$HOME/.git"
backup_item "$HOME/.config/opencode/memory_data"
backup_item_excluding "$HOME/.opencode" ".opencode" ".git" "*/.git"
backup_item_excluding "$HOME/.claude" ".claude" ".git" "*/.git"
backup_item_excluding "$HOME/.agents" ".agents" ".git" "*/.git"

echo 'Cleaning up tmux...'
rm -f "$HOME/.tmux.conf.local"
rm -rf "$HOME/.config/tmux-powerline"

echo 'Cleaning up VSCode...'
backup_item "$HOME/.vscode-server/extensions/extensions.json"
rm -rf "$HOME/.vscode"
rm -rf "$HOME/.vscode-server"
rm -rf "$HOME/.config/Code/User/prompts"
# Restore extensions.json as a real file (not stowed)
if [ -f "$HOME/.backups/extensions.json" ]; then
  mkdir -p "$HOME/.vscode-server/extensions"
  cp -f "$HOME/.backups/extensions.json" "$HOME/.vscode-server/extensions/extensions.json"
  echo "  restored extensions.json as real file"
fi

echo 'Cleaning up other files...'
rm -f "$HOME/.gitconfig"
rm -f "$HOME/.alacritty.yml"
rm -f "$HOME/.antigenrc"
rm -f "$HOME/bash_completion.d"
rm -f "$HOME/default.yml"
rm -f "$HOME/.dxvk"
rm -f "$HOME/.hushlogin"
rm -f "$HOME/.zprofile"
rm -f "$HOME/.profile"
rm -f "$HOME/.tmuxp"
rm -f "$HOME/.vimrc"
rm -f "$HOME/.virc"
rm -f "$HOME/.gnupg/gpg.conf"
rm -f "$HOME/.gnupg/gpg-agent.conf"
rm -f "$HOME/.zsh"
rm -f "$HOME/.zshrc"
rm -f "$HOME/.zshrc.pre-oh-my-zsh"
rm -f "$HOME/.zalias"
rm -f "$HOME/.zfunctions"
rm -f "$HOME/.git"
rm -f "$HOME/.config/wireplumber/wireplumber.conf.d/51-priority-override.conf"
rm -f "$HOME/.config/kwinrulesrc"
rm -f "$HOME/.config/alacritty/alacritty.toml"
rm -f "$HOME/.config/htop/htoprc"

# GitHub #241: these paths are tracked inside stow package source trees.
# `rm -f` through a stow-created directory symlink can delete the source
# file; safe_rm_stow_target guards against that by unlinking the symlink
# instead (see helper definition above).
DOTFILES_PATH=${DOTFILES_PATH:-$HOME/.dotfiles}
safe_rm_stow_target "$HOME/.pyenv/version" "$DOTFILES_PATH/linux/python/.pyenv"
safe_rm_stow_target "$HOME/.ruby-version" "$DOTFILES_PATH/linux/systems/.ruby-version"
safe_rm_stow_target "$HOME/.gemrc" "$DOTFILES_PATH/linux/systems/.gemrc"
safe_rm_stow_target "$HOME/.railsrc" "$DOTFILES_PATH/linux/systems/.railsrc"
safe_rm_stow_target "$HOME/.supermodel/Config/Supermodel.ini" "$DOTFILES_PATH/linux/supermodel/.supermodel/Config"

if [ -L "$HOME/.local/share/kwin/scripts" ]; then
  rm -f "$HOME/.local/share/kwin/scripts"
fi

if [ -L "$HOME/.local/share/kservices5" ]; then
  rm -f "$HOME/.local/share/kservices5"
fi

# Clean up old opencode directory structure (moved to linux/opencode)
if [ -d "$HOME/.dotfiles/opencode" ] && [ ! -f "$HOME/.dotfiles/opencode/.config/opencode/opencode.jsonc" ]; then
  echo 'Cleaning up old opencode directory...'
  rm -rf "$HOME/.dotfiles/opencode"
fi

# Backup oh-my-opencode-slim state before cleanup (real file, not symlink)
mkdir -p "$HOME/.backups/opencode/omos"
omos_file="$HOME/.config/opencode/oh-my-opencode-slim.json"
if [ -f "$omos_file" ] && [ ! -L "$omos_file" ]; then
    cp "$omos_file" "$HOME/.backups/opencode/omos/"
fi

# Clean up opencode symlinks, old folders & stale files before restow
# NOTE: opencode.jsonc is now a real file (copied from template), not a symlink — do NOT remove it
rm -f "$HOME/.config/opencode/opencode-mem.json"
rm -f "$HOME/.config/opencode/package.json"
rm -f "$HOME/.config/opencode/bun.lock"
rm -f "$HOME/.config/opencode/tui.json"
rm -f "$HOME/.config/opencode/AGENTS.md"
rm -f "$HOME/.config/opencode/GIT_COMMIT_GUARD.md"
# .env.example removed — tokens now live in ~/.profile.local
rm -f "$HOME/.zopencode"
rm -rf "$HOME/.opencode"
rm -rf "$HOME/.config/opencode/agent"
rm -rf "$HOME/.config/opencode/agents"
rm -rf "$HOME/.config/opencode/plugin"
rm -rf "$HOME/.config/opencode/plugins"
rm -rf "$HOME/.config/opencode/skills"

# Clean up claude symlinks & stale files before restow
# Note: settings.json and projects/ are user data, don't remove
rm -f "$HOME/.claude/CLAUDE.md"
rm -f "$HOME/.claude/.gitignore"
rm -f "$HOME/.claude/.gitkeep"
# Clean up .agents/skills (generated by devtools-ai)
rm -rf "$HOME/.agents/skills"
# mkdir -p "$HOME/.agents/skills"

# Create some files
# rm -f $HOME/.config/opencode/memory_data
mkdir -p "$HOME/.config/opencode/memory_data"

# Backup SSH directory
echo 'y' || cp -rf "$HOME/.ssh" "$HOME/.ssh-backup"
