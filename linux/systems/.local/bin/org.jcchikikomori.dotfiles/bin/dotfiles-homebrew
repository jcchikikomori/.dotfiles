#!/bin/sh

# Source shared SteamOS read-only rootfs guard. dotfiles-homebrew install
# runs Homebrew's official installer, which uses sudo for system paths
# (/home/linuxbrew/, sometimes /etc/profile.d/) and fails on a read-only
# SteamOS rootfs. The shared helper tells the user to disable read-only
# first instead of letting the installer explode.
script_dir() {
  script="$0"
  case "$script" in
    */*) path="$script" ;;
    *) path=$(command -v "$script" 2>/dev/null || printf '%s' "$script") ;;
  esac
  dir=$(dirname "$path")
  (CDPATH=; cd "$dir" 2>/dev/null && pwd) || pwd
}

SCRIPT_DIR=$(script_dir)
. "$SCRIPT_DIR/dotfiles-steamos-readonly"

if [ "$1" = "install" ]; then
  require_writeable_rootfs || exit 1
  if [ -x "/bin/bash" ]; then
    echo "Installing Homebrew (Linuxbrew)..."
    /bin/bash -c "$(NONINTERACTIVE=1 curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  else
    echo "Error: /bin/bash not found or not executable." >&2
    exit 1
  fi
elif [ "$1" = "update" ]; then
  if command -v brew >/dev/null 2>&1; then
    brew update
  elif [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
    /home/linuxbrew/.linuxbrew/bin/brew update
  elif [ -x "${HOME}/.linuxbrew/bin/brew" ]; then
    "${HOME}/.linuxbrew/bin/brew" update
  else
    echo "Error: brew not found; run '$0 install' first." >&2
    exit 1
  fi
else
  echo "Usage: $0 {install|update}"
  echo "  install: Install Homebrew (Linuxbrew)"
  echo "  update: Update Homebrew formula index (brew update)"
  exit 1
fi
