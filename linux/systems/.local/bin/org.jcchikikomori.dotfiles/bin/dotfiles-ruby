#!/bin/sh

set -eu

DISTRO_FILE="${HOME}/.dotfiles-distro"
RUBY_INSTALL_METHOD="${RUBY_INSTALL_METHOD:-system}"

log() {
  printf '[dotfiles-ruby] %s\n' "$*"
}

install_complete_msg() {
  log "System-wide Ruby installation complete. Version: $(ruby --version)"
}

homebrew_hint() {
  log "Hitting native gem build errors? Try 'RUBY_INSTALL_METHOD=homebrew $0 install' - see docs/RubyHomebrewToolchain.md"
}

script_dir() {
  script="$0"
  case "$script" in
    */*)
      path="$script"
      ;;
    *)
      path=$(command -v "$script" 2>/dev/null || printf '%s' "$script")
      ;;
  esac
  dir=$(dirname "$path")
  (CDPATH=; cd "$dir" 2>/dev/null && pwd) || pwd
}

SCRIPT_DIR=$(script_dir)

run_sudo() {
  if command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    "$@"
  fi
}

ensure_homebrew() {
  if command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
    return 0
  fi

  for brew_bin in \
    "${HOMEBREW_PREFIX:-}/bin/brew" \
    "${HOME}/.linuxbrew/bin/brew" \
    "/home/linuxbrew/.linuxbrew/bin/brew"; do
    if [ -x "$brew_bin" ]; then
      log "Using Homebrew at $brew_bin"
      eval "$("$brew_bin" shellenv)"
      return 0
    fi
  done

  return 1
}

ensure_homebrew_ready() {
  if ensure_homebrew; then
    return 0
  fi

  log "Homebrew not detected; installing via dotfiles-homebrew..."
  if [ -x "${SCRIPT_DIR}/dotfiles-homebrew" ]; then
    "${SCRIPT_DIR}/dotfiles-homebrew" install
  elif command -v dotfiles-homebrew >/dev/null 2>&1; then
    dotfiles-homebrew install
  else
    log "dotfiles-homebrew helper not found."
    exit 1
  fi

  if ! ensure_homebrew; then
    log "Homebrew still unavailable after installation."
    exit 1
  fi
}

ensure_distro_file() {
  if [ -r "$DISTRO_FILE" ]; then
    return 0
  fi

  if [ -x "${SCRIPT_DIR}/dotfiles-distro" ]; then
    "${SCRIPT_DIR}/dotfiles-distro" install >/dev/null 2>&1 || "${SCRIPT_DIR}/dotfiles-distro" install
  elif command -v dotfiles-distro >/dev/null 2>&1; then
    dotfiles-distro install >/dev/null 2>&1 || dotfiles-distro install
  else
    log "dotfiles-distro helper not found; assuming unknown distribution."
    return 1
  fi
}

read_distro() {
  ensure_distro_file || true
  if [ -r "$DISTRO_FILE" ]; then
    distro=$(sed -n '1p' "$DISTRO_FILE" | tr '[:upper:]' '[:lower:]')
    if [ -n "$distro" ]; then
      printf '%s\n' "$distro"
      return 0
    fi
  fi
  printf 'unknown\n'
}

install_ruby_debian() {
  log "Installing Ruby via apt..."
  run_sudo apt-get update
  run_sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y ruby-full build-essential
  log "Installing rbenv via apt..."
  run_sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y rbenv ruby-ffi rubocop rubygems
  install_complete_msg
  homebrew_hint
}

install_ruby_fedora() {
  installer="dnf"
  if ! command -v dnf >/dev/null 2>&1; then
    installer="yum"
  fi
  log "Installing Ruby via $installer..."
  run_sudo "$installer" -y install ruby
  log "Installing rbenv via $installer..."
  run_sudo "$installer" -y install rbenv ruby-build-rbenv
  homebrew_hint
}

install_ruby_arch() {
  log "Installing Ruby via pacman..."
  run_sudo pacman -Sy --needed --noconfirm ruby base-devel
  log "Installing rbenv via pacman..."
  run_sudo pacman -Sy --needed --noconfirm rbenv ruby-ffi ruby-lsp rubocop rubygems
  install_complete_msg
}

install_ruby_opensuse() {
  log "Installing Ruby via zypper..."
  run_sudo zypper --non-interactive refresh
  run_sudo zypper --non-interactive install ruby ruby-devel make gcc gcc-c++
}

install_ruby_alpine() {
  log "Installing Ruby via apk..."
  run_sudo apk add --no-cache ruby ruby-dev build-base
}

install_ruby_gentoo() {
  log "Installing Ruby via emerge..."
  run_sudo emerge --quiet dev-lang/ruby
}

install_ruby_void() {
  log "Installing Ruby via xbps..."
  run_sudo xbps-install -Sy ruby ruby-devel base-devel
}

install_ruby_clearlinux() {
  log "Installing Ruby via swupd..."
  run_sudo swupd bundle-add ruby-basic
}

install_ruby_homebrew() {
  log "Falling back to Homebrew/Linuxbrew for Ruby installation..."
  ensure_homebrew_ready

  export HOMEBREW_NO_ANALYTICS=1
  export HOMEBREW_NO_ENV_HINTS=1
  brew update
  brew install ruby
}

# Full Homebrew install path for stable Linux distros opted in via
# RUBY_INSTALL_METHOD=homebrew (see install_ruby_for). Distinct from
# install_ruby_homebrew (the minimal unknown-distro fallback above): this
# also installs the native gem build dependencies that Bundler's native
# extensions (mysql2, nokogiri, rmagick, etc.) typically need, so they link
# consistently against Homebrew's own libs instead of the distro's.
install_ruby_homebrew_full() {
  log "Installing Ruby via Homebrew (RUBY_INSTALL_METHOD=homebrew)..."
  ensure_homebrew_ready

  export HOMEBREW_NO_ANALYTICS=1
  export HOMEBREW_NO_ENV_HINTS=1
  brew update
  brew install ruby
  install_ruby_native_gem_deps
  install_complete_msg
}

# Minimal, additive set of native gem build dependencies. Not exhaustive -
# a given Gemfile may still need extra brew formulae; add them there.
install_ruby_native_gem_deps() {
  log "Installing common native gem build dependencies via Homebrew..."
  brew install openssl libffi libyaml mysql-client imagemagick || \
    log "Warning: one or more native gem build dependencies failed to install via Homebrew."
}

# Resolves the versioned gcc/g++ binary (e.g. gcc-16) in a Homebrew bin
# dir, given the exact prefix ("gcc-" or "g++-"). A plain 'gcc-*' glob also
# matches wrapper binaries like gcc-ar-16/gcc-ranlib-16/gcc-nm-16, which
# sort after the real compiler and get picked instead - filter to names
# whose remainder after the prefix is purely numeric.
find_homebrew_gcc_binary() {
  prefix="$1"
  dir="$2"
  find "$dir" -maxdepth 1 -type f -name "${prefix}*" 2>/dev/null | while IFS= read -r f; do
    base=$(basename "$f")
    rest=${base#"$prefix"}
    case "$rest" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$f" ;;
    esac
  done | sort -V | tail -1
}

# Fallback for a pinned Ruby version that isn't available as a Homebrew
# bottle. Builds via Homebrew's own rbenv/ruby-build (not the distro's,
# which would compile against the system gcc) and forces CC/CXX to
# Homebrew's own gcc/g++ for this one build only, so the resulting Ruby's
# native-extension linking stays consistent with a single toolchain/glibc
# end-to-end. Mixing system and Homebrew toolchains on the same Ruby is
# what causes native gem extensions to fail to link (or link but crash on
# a glibc symbol version mismatch at runtime) - not currently wired into
# install_ruby_for since there is no version-pinning input yet, but kept
# here so the pattern exists and is manually invokable.
install_ruby_pinned_homebrew() {
  version="$1"
  if [ -z "$version" ]; then
    log "Usage: install_ruby_pinned_homebrew <ruby-version>"
    return 1
  fi

  ensure_homebrew_ready
  brew install rbenv ruby-build

  brew_prefix=$(brew --prefix)
  cc=$(find_homebrew_gcc_binary "gcc-" "${brew_prefix}/bin")
  cxx=$(find_homebrew_gcc_binary "g++-" "${brew_prefix}/bin")

  if [ -z "$cc" ] || [ -z "$cxx" ]; then
    log "Homebrew gcc/g++ not found; installing gcc via Homebrew..."
    brew install gcc
    cc=$(find_homebrew_gcc_binary "gcc-" "${brew_prefix}/bin")
    cxx=$(find_homebrew_gcc_binary "g++-" "${brew_prefix}/bin")
  fi

  if [ -z "$cc" ] || [ -z "$cxx" ]; then
    log "Could not resolve Homebrew gcc/g++ binaries; aborting."
    return 1
  fi

  log "Building Ruby ${version} via rbenv/ruby-build using Homebrew's own gcc/g++ ($cc / $cxx)..."
  env CC="$cc" CXX="$cxx" PATH="${brew_prefix}/bin:$PATH" rbenv install "$version"
}

install_ruby_for() {
  distro="$1"
  case "$distro" in
    debian|ubuntu|linuxmint|pop|neon|zorin|kali|raspbian)
      if [ "$RUBY_INSTALL_METHOD" = "homebrew" ]; then
        install_ruby_homebrew_full
      else
        install_ruby_debian
      fi
      ;;
    fedora|centos|rhel)
      if [ "$RUBY_INSTALL_METHOD" = "homebrew" ]; then
        install_ruby_homebrew_full
      else
        install_ruby_fedora
      fi
      ;;
    arch|archbtw|manjaro|endeavouros|garuda|arcolinux|steamos)
      install_ruby_arch
      ;;
    unknown|*)
      install_ruby_homebrew
      ;;
  esac
}

install_action() {
  distro=$(read_distro)
  log "Detected distribution from cache: $distro"
  install_ruby_for "$distro"
}

update_action() {
  distro=$(read_distro)
  log "Updating Ruby for distribution: $distro"
  install_ruby_for "$distro"
  log "Ruby update complete."
}

# Writes a per-project .envrc (direnv) pinning RBENV_VERSION to the
# Homebrew-toolchain rbenv version created by install_ruby_pinned_homebrew
# (<version>-brew), without touching the project's own shared/git-tracked
# .ruby-version. Run this from inside the project's repo root. See
# docs/RubyHomebrewToolchain.md for why this stays per-project rather than
# something dotfiles applies globally.
cmd_envrc() {
  version="$1"
  if [ -z "$version" ]; then
    log "Usage: $0 envrc <ruby-version>"
    return 1
  fi

  envrc_file=".envrc"
  rbenv_version="${version}-brew"
  export_line="export RBENV_VERSION=${rbenv_version}"

  if [ -f "$envrc_file" ]; then
    if grep -q '^export RBENV_VERSION=' "$envrc_file" 2>/dev/null; then
      log "$envrc_file already sets RBENV_VERSION; leaving it as-is."
    else
      printf '\n# Added by dotfiles-ruby envrc\n%s\n' "$export_line" >> "$envrc_file"
      log "Appended RBENV_VERSION=${rbenv_version} to existing $envrc_file"
    fi
  else
    printf '# Managed by dotfiles-ruby envrc - keep this out of git (see ~/.config/git/ignore)\n%s\n' "$export_line" > "$envrc_file"
    log "Created $envrc_file with RBENV_VERSION=${rbenv_version}"
  fi

  if command -v direnv >/dev/null 2>&1; then
    direnv allow "$envrc_file"
  else
    log "direnv not found; install it, then run 'direnv allow' to activate $envrc_file"
  fi
}

usage() {
  echo "Usage: $0 {install|update|envrc <ruby-version>}"
  echo "  install: Install Ruby using the distribution package manager"
  echo "  update: Update Ruby via the distribution package manager"
  echo "  envrc: Write a per-project .envrc pinning RBENV_VERSION=<version>-brew"
}

main() {
  if [ $# -eq 0 ]; then
    usage
    exit 1
  fi

  case "$1" in
    install)
      install_action
      ;;
    update)
      update_action
      ;;
    envrc)
      cmd_envrc "${2:-}"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
